# --- Anthropic credentials -------------------------------------------------
# No API key is required here. Recommended: run `ant auth login` once (on
# your machine or in CI) and leave this file's credential lines untouched --
# the SDK picks up that login automatically. ANTHROPIC_API_KEY /
# ANTHROPIC_AUTH_TOKEN below are optional fallbacks (e.g. for deployment
# environments where an interactive `ant auth login` isn't possible).
# Check what's actually active with `ant auth status`, or hit GET /health/llm
# once the app is running.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Model used by the agent unless overridden below.
ANTHROPIC_MODEL=claude-opus-5

# --- Microservice upgrade agent --------------------------------------------
# Upgrades a Java/Spring microservice (Java 8->21, Spring 4->6, Spring Boot
# 1.5->3.5 by default) via POST /upgrade, iterating build+startup attempts
# until green. Falls back to ANTHROPIC_MODEL when unset.
# UPGRADE_AGENT_MODEL=claude-opus-5
UPGRADE_AGENT_EFFORT=xhigh
UPGRADE_MAX_VERIFICATION_CYCLES=5
UPGRADE_MAX_TOOL_TURNS_PER_CYCLE=25
UPGRADE_BUILD_TIMEOUT_SECONDS=900
UPGRADE_STARTUP_TIMEOUT_SECONDS=90
UPGRADE_COMMAND_TIMEOUT_SECONDS=300
# Long-term memory: summaries of up to this many earlier runs against the
# same repo are shown to the agent at kickoff. 0 disables it.
UPGRADE_MEMORY_MAX_PRIOR_RUNS=3

# SQLite by default -- zero setup. Point this at Postgres for production
# (e.g. postgresql+psycopg://user:pass@host:5432/microservice_upgrade_agent).
DATABASE_URL=sqlite:///./microservice_upgrade_agent.db

# Set to true to force the agent onto a deterministic mock LLM instead of
# calling the real Anthropic API. Used by the test suite; handy for local
# development without API credentials.
LLM_MOCK_MODE=false

ENVIRONMENT=development
